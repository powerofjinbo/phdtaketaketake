# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# uv lockfile — this repo ships as a skill + library, not a locked-runtime
# app; the lockfile gets generated locally when contributors run `uv run`
# and shouldn't churn the tree.
uv.lock

# Virtualenv
.venv/
venv/
env/
.env

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Type checking
.mypy_cache/
.ruff_cache/

# Editor
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Local data caches (large pre-computed advisor caches go to releases, not repo)
*.sqlite
*.db
data/advisors/*.sqlite
data/advisors_cache/

# Notebook checkpoints
.ipynb_checkpoints/

# app (web product)
app/backend/.venv/
app/frontend/node_modules/
app/frontend/.next/
app/frontend/out/
app/backend/*.db
app/backend/.env
