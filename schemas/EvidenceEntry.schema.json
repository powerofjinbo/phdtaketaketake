{
  "$defs": {
    "EvidenceSource": {
      "additionalProperties": false,
      "description": "A single, structured piece of evidence for one or more claims.\n\nGoes inside `EvidenceEntry.items` (preferred over the legacy bare-URL\n`sources` list). A URL alone doesn't tell the matcher *what* it\nsupports; this structure binds a URL to a human-readable claim and\nthe field name(s) it backs, so an audit can verify each claim\nindividually.",
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "lab_page",
            "faculty_page",
            "google_scholar",
            "openalex",
            "inspire",
            "pubmed",
            "europe_pmc",
            "semantic_scholar",
            "arxiv",
            "biorxiv",
            "dblp",
            "openreview",
            "csrankings",
            "mathscinet",
            "math_genealogy",
            "us_news",
            "nas",
            "hhmi",
            "nih_reporter",
            "clinicaltrials_gov",
            "genealogy",
            "paper",
            "cv",
            "other"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "supports_fields": {
          "items": {
            "type": "string"
          },
          "title": "Supports Fields",
          "type": "array"
        },
        "quote_or_snippet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote Or Snippet"
        },
        "last_checked": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Checked"
        }
      },
      "required": [
        "url",
        "source_type",
        "claim"
      ],
      "title": "EvidenceSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Sources backing a signal, with audit trail.\n\nTwo formats:\n  - `items` (preferred): list of structured `EvidenceSource` records,\n    each binding a URL to a specific claim and supports_fields list.\n  - `sources` (legacy): list of bare URLs. Kept for back-compat — only\n    accepted in default mode. **Strict mode rejects bare sources** as\n    claim-level proof.\n\nEmpty both means the agent didn't verify this claim → matcher counts\nit as unverified.",
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/EvidenceSource"
      },
      "title": "Items",
      "type": "array"
    },
    "sources": {
      "items": {
        "type": "string"
      },
      "title": "Sources",
      "type": "array"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "last_checked": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Checked"
    }
  },
  "title": "EvidenceEntry",
  "type": "object"
}
